# OMNIEL voice agent. Copy to .env and fill in; .env is gitignored.
# See README.md for where each value comes from.

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The website this agent serves. Its /api/agent/tools endpoint must be reachable.
SITE_URL=https://omniel.com.ng
# Must equal AGENT_SHARED_SECRET on the website.
AGENT_SHARED_SECRET=
