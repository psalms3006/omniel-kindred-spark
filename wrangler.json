{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omniel-evolve",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "d1_databases": [
    {
      "binding": "ENQUIRIES_DB",
      "database_name": "omniel-enquiries",
      "database_id": "d408764f-7928-47b7-86f2-06f75f86ed5a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
