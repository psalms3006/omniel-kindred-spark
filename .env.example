# Cloudflare Web Analytics beacon token.
VITE_CF_BEACON_TOKEN=

# --- Voice assistant (LiveKit) ------------------------------------------------
# All server-only. The site uses these to issue a visitor's room token
# (/api/livekit/token); the agent itself is a separate service. From the
# LiveKit project's Settings > Keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret proving a call to /api/agent/tools really came from the agent.
# Set the same value here and on the agent.
AGENT_SHARED_SECRET=

# --- Email delivery (Resend) --------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Inbound enquiries and waitlist notifications. Defaults to info@omniel.com.ng.
OMNIEL_ENQUIRY_EMAIL=
WAITLIST_TOKEN_SECRET=

RESEND_WAITLIST_SEGMENT_ID=
