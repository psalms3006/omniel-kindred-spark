# Cloudflare Web Analytics beacon token.
VITE_CF_BEACON_TOKEN=

# Vapi voice assistant. Both are required to enable the widget; if either is
# missing the assistant is disabled and the site works normally.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
OMNIEL_ENQUIRY_EMAIL=


# Secret used to sign NOVA waitlist confirmation links (HMAC-SHA256).
# Generate a long random string, e.g. `openssl rand -hex 32`. Changing it
# invalidates any confirmation links currently sitting in people's inboxes.
WAITLIST_TOKEN_SECRET=

# Optional Resend Segment id to add waitlist contacts to, for later broadcasts.
# Find it under Resend -> Contacts -> Segments.
RESEND_WAITLIST_SEGMENT_ID=
