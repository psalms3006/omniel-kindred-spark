# OMNIEL environment.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Anything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
# Everything else is server-only and must stay that way.

# --- Email delivery (Resend) -------------------------------------------------
# Server-only. Create at https://resend.com/api-keys with "Sending access".
RESEND_API_KEY=
# Must be on a domain verified in Resend. The root domain omniel.com.ng is the
# verified one; send.omniel.com.ng is only Resend's bounce-handling subdomain
# and is NOT a valid sender.
RESEND_FROM_EMAIL="OMNIEL <noreply@omniel.com.ng>"
# Where enquiries and call summaries are delivered.
OMNIEL_ENQUIRY_EMAIL=hello@omniel.com.ng
# Optional. Routes voice call summaries somewhere other than the enquiry inbox.
OMNIEL_SUMMARY_EMAIL=

# --- Voice assistant (LiveKit) -----------------------------------------------
# All server-only. The site uses them to issue a visitor's room token
# (/api/livekit/token); the agent itself is a separate service in agent/ with
# its own copy of the three LIVEKIT_ values (see agent/README.md).
# From the LiveKit Cloud project's Settings > Keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret proving a call to /api/agent/tools really came from the agent.
# Set the same value here and on the agent. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_SHARED_SECRET=

# --- Spam protection (Cloudflare Turnstile) ----------------------------------
# The site key is public and must be VITE_-prefixed to reach the widget.
VITE_TURNSTILE_SITE_KEY=
# Server-only. Never expose this.
TURNSTILE_SECRET_KEY=

# --- Deployment tooling only -------------------------------------------------
# NOT used by the website at runtime. These exist so wrangler can deploy and so
# operational scripts can reach the Cloudflare API. They are never read by any
# code that runs in the Worker, and must not be added as Worker secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
